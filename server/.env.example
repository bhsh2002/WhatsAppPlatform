# ============================================
# WhatsApp Management Platform — Environment
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Server
PORT=3031

# JWT Secret for authentication (REQUIRED, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encryption key for sensitive data at rest (REQUIRED, 32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_KEY=

# CORS origins (comma-separated, defaults to localhost:5173,5174 in dev)
# CORS_ORIGINS=https://wa.savana.ly

# Meta WhatsApp Cloud API
WEBHOOK_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
# Optional explicit public callback URL for Meta app webhooks in production.
# Use the exact URL configured through your reverse proxy, for example:
# META_WEBHOOK_CALLBACK_URL=https://wa.savana.ly/webhook
# or META_WEBHOOK_CALLBACK_URL=https://wa.savana.ly/api/webhook
META_WEBHOOK_CALLBACK_URL=

# Facebook OAuth (for self-service page linking)
# Set to your callback URL — must match Meta App Dashboard > Facebook Login > Valid OAuth Redirect URIs
# Production: https://wa.savana.ly/auth/facebook/callback
# Development: http://localhost:3031/auth/facebook/callback
FACEBOOK_REDIRECT_URI=

# WhatsApp Embedded Signup config_id (from Meta App Dashboard > WhatsApp > Embedded Signup)
WA_EMBEDDED_SIGNUP_CONFIG_ID=

# Default credentials (used when no tenant-specific credentials exist)
DEFAULT_PHONE_NUMBER_ID=
DEFAULT_ACCESS_TOKEN=

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info
