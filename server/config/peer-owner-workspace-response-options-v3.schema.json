{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:savana:workspace:response-options:3",
  "title": "Current closed product, service-sharing and actual native action option definitions",
  "description": "Definitions for actual workspace response properties. No new HTTP wrapper, input permission or execution authority is defined.",
