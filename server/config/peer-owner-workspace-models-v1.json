        "type": "string"
      }
    },
    "required": [
      "activity_id"
    ],
    "title": "WorkspaceProviderPrepare",
    "type": "object"
  },
  "WorkspaceCapabilityGrant": {
    "additionalProperties": false,
    "properties": {
      "provider_ref": {
        "maxLength": 255,
        "minLength": 1,
        "title": "Provider Ref",
        "type": "string"
      },
      "capability_code": {
        "maxLength": 100,
        "minLength": 1,
        "title": "Capability Code",
        "type": "string"
      },
      "actions": {
        "items": {
          "enum": [
            "read",
            "request",
            "approve",
            "execute",
            "reconcile"
          ],
          "type": "string"
        },
        "maxItems": 5,
        "title": "Actions",
        "type": "array"
      },
      "allowed_fields": {
        "items": {
          "type": "string"
        },
        "maxItems": 100,
        "title": "Allowed Fields",
        "type": "array"
      },
      "resource_refs": {
        "items": {
          "type": "string"
        },
        "maxItems": 100,
        "title": "Resource Refs",
        "type": "array"
      },
      "resource_policy": {
        "default": "selected",
        "enum": [
          "new_only",
          "selected",
          "activity"
        ],
        "title": "Resource Policy",
        "type": "string"
      },
      "expires_at": {
        "format": "date-time",
        "title": "Expires At",
        "type": "string"
      },
      "expected_version": {
        "minimum": 0,
        "title": "Expected Version",
        "type": "integer"
      }
    },
    "required": [
