# ============================================
# WhatsApp Management Platform — Environment
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Server
PORT=3031

# Runtime mode. Docker sets this to production automatically.
# NODE_ENV=development

# Development-only escape hatch for testing unsigned webhook payloads.
# This flag is ignored in production. Keep it disabled by default.
# ALLOW_UNSIGNED_WEBHOOKS=false

# JWT Secret for authentication (REQUIRED, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encryption key for sensitive data at rest (REQUIRED, 32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_KEY=

# Required only when the users table is empty. The server creates exactly one
# administrator before listening and never prints this value. Rotate it after
# first login, then remove it from the runtime environment.
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=admin@localhost.invalid
# BOOTSTRAP_ADMIN_NAME=Platform Administrator

# Optional dedicated token for Prometheus GET /metrics scraping. When omitted,
# the endpoint returns 404. Use at least 32 random characters; do not reuse JWT_SECRET.
# METRICS_TOKEN=

# CORS origins (comma-separated, defaults to localhost:5173,5174 in dev)
# CORS_ORIGINS=https://wa.savana.ly

# Meta WhatsApp Cloud API
# REQUIRED in production. WEBHOOK_VERIFY_TOKEN must match Meta App Dashboard.
WEBHOOK_VERIFY_TOKEN=
# REQUIRED in production. Used for webhook signature verification and token diagnostics.
META_APP_ID=
META_APP_SECRET=
# Optional explicit public callback URL for Meta app webhooks in production.
# Use the exact URL configured through your reverse proxy, for example:
# META_WEBHOOK_CALLBACK_URL=https://wa.savana.ly/webhook
# or META_WEBHOOK_CALLBACK_URL=https://wa.savana.ly/api/webhook
META_WEBHOOK_CALLBACK_URL=

# Public Wa Savana API URL used by every linked SMS account for signed callbacks.
# The server appends a random per-account webhook key. HTTPS is mandatory in production.
# Example: https://wa.savana.ly/api/integrations/sms-gateway/events
SMS_GATEWAY_CALLBACK_BASE_URL=
# Signed delivery/status callbacks per minute from all SMS accounts sharing one source IP.
# SMS_WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
# Revalidate enabled SMS credentials/connectivity every 1-60 minutes (default 5 minutes).
# SMS_HEALTH_INTERVAL_MS=300000

# Facebook Content Studio writing providers (server-side only).
# Provider identities, keys, models, and upstream errors are never exposed to tenants.
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Gemini offers a limited free tier in supported projects and regions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional paid fallback/primary provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_TIMEOUT_MS=30000

# Durable Facebook content scheduler
CONTENT_SCHEDULER_INTERVAL_MS=60000
CONTENT_SCHEDULER_BATCH_SIZE=10

# Canonical HTTPS origin used in public data-deletion status links.
PUBLIC_APP_URL=https://wa.savana.ly

# Facebook OAuth (for self-service page linking)
# Set to your callback URL — must match Meta App Dashboard > Facebook Login > Valid OAuth Redirect URIs
# Production: https://wa.savana.ly/auth/facebook/callback
# Development: http://localhost:3031/auth/facebook/callback
FACEBOOK_REDIRECT_URI=

# WhatsApp Embedded Signup config_id (from Meta App Dashboard > WhatsApp > Embedded Signup)
WA_EMBEDDED_SIGNUP_CONFIG_ID=

# Default credentials (used when no tenant-specific credentials exist)
DEFAULT_PHONE_NUMBER_ID=
DEFAULT_ACCESS_TOKEN=

# Log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# Default timeout for external fetch calls (milliseconds, clamped to 1s–120s).
# OUTBOUND_FETCH_TIMEOUT_MS=30000
# Attempts for safe GET/HEAD calls on 429/5xx/network errors (1–4, default 3).
# OUTBOUND_SAFE_FETCH_ATTEMPTS=3

# Maximum proxied media download size in bytes (default 25 MiB, maximum 100 MiB).
# MAX_MEDIA_DOWNLOAD_BYTES=26214400

# SQLite lock wait in milliseconds (clamped to 1000–30000; default 5000).
# SQLITE_BUSY_TIMEOUT_MS=5000

# Optional SQLite path override, useful for isolated tests and managed volumes.
# DATABASE_PATH=/app/db/platform.db

# Disable maintenance/token schedulers in isolated smoke/E2E environments.
# DISABLE_BACKGROUND_JOBS=false
# Optional Savana control plane. Wa Savana core messaging remains independent
# when this adapter is disabled.
SAVANA_INTEGRATIONS_ENABLED=false
SAVANA_CONNECT_URL=http://savana-connect:8010
SAVANA_CONNECT_PLATFORM_TOKEN=
# With docker-compose.server.yml Connect reaches this private callback directly.
SAVANA_CONNECT_CALLBACK_URL=http://wa-savana-server:3031/integrations/connect/events
SAVANA_CONNECT_CALLBACK_TOKEN=
SAVANA_SUBSCRIPTIONS_URL=http://savana-subscriptions:8020
SAVANA_SUBSCRIPTIONS_PLATFORM_TOKEN=
SAVANA_SUBSCRIPTIONS_SIGNING_SECRET=
SAVANA_SUBSCRIPTIONS_MODE=local
SAVANA_CONTROL_PLANE_TIMEOUT_MS=10000
