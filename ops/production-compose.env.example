# Copy outside the release checkout, set mode 0600, and replace every placeholder.
# Both images must use immutable sha256 digests from the same tested release commit.
WA_SERVER_IMAGE_DIGEST=REPLACE_WITH_64_HEX_DIGEST
WA_CLIENT_IMAGE_DIGEST=REPLACE_WITH_64_HEX_DIGEST
WA_RELEASE_SHA=REPLACE_WITH_40_HEX_GIT_COMMIT
WA_RUNTIME_ENV_FILE=/srv/wa-savana/shared/production-runtime.env
WA_DATA_DIR=/srv/wa-savana/shared/data
WA_UPLOADS_DIR=/srv/wa-savana/shared/uploads
