        "activity_id",
        "provider_ref",
        "capability",
        "action",
        "available",
        "allowed_fields",
        "authorization_revision",
        "source_installation_id",
        "reason_code",
        "message"
      ],
      "title": "WorkspaceProductCommandOption",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              }
            },
            "required": [
              "available"
            ]
          },
          "then": {
            "properties": {
              "authorization_revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_installation_id": {
                "type": "string",
                "minLength": 1
              },
              "allowed_fields": {
                "minItems": 1
              },
              "reason_code": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "authorization_revision": {
                "type": "null"
              },
              "source_installation_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "available": {
                "const": true
              },
              "action": {
                "const": "product.change"
              }
            },
            "required": [
              "available",
              "action"
            ]
          },
          "then": {
            "required": [
              "record_ref",
              "record_version"
            ],
            "properties": {
              "record_ref": {
                "type": "string",
                "minLength": 1
              },
              "record_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
