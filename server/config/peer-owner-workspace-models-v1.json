{
  "WorkspaceActivityCreate": {
    "additionalProperties": false,
    "properties": {
      "name": {
        "maxLength": 200,
        "minLength": 2,
        "title": "Name",
        "type": "string"
      },
      "idempotency_key": {
        "maxLength": 255,
        "minLength": 8,
        "title": "Idempotency Key",
        "type": "string"
      }
    },
    "required": [
      "name",
      "idempotency_key"
    ],
    "title": "WorkspaceActivityCreate",
    "type": "object"
  },
  "WorkspaceBindingRequest": {
    "additionalProperties": false,
    "properties": {
      "external_tenant_id": {
        "maxLength": 255,
        "minLength": 1,
        "title": "External Tenant Id",
        "type": "string"
      },
      "display_name": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Display Name",
        "type": "string"
      },
      "redirect_uri": {
        "maxLength": 2048,
        "minLength": 1,
        "title": "Redirect Uri",
        "type": "string"
      },
      "state": {
        "maxLength": 255,
        "minLength": 32,
        "title": "State",
        "type": "string"
      },
      "expected_selection_revision": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Expected Selection Revision",
        "type": "string"
      }
    },
    "required": [
      "external_tenant_id",
      "display_name",
      "redirect_uri",
      "state",
      "expected_selection_revision"
    ],
    "title": "WorkspaceBindingRequest",
    "type": "object"
  },
  "WorkspaceSelectionRequest": {
    "additionalProperties": false,
    "properties": {
      "activity_id": {
        "maxLength": 255,
        "minLength": 1,
        "title": "Activity Id",
        "type": "string"
      },
      "provider_ref": {
        "maxLength": 255,
        "minLength": 1,
        "title": "Provider Ref",
        "type": "string"
      },
      "external_tenant_id": {
        "maxLength": 255,
        "minLength": 1,
        "title": "External Tenant Id",
        "type": "string"
      },
      "expected_selection_revision": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Expected Selection Revision",
        "type": "string"
      },
      "idempotency_key": {
        "maxLength": 255,
        "minLength": 8,
        "title": "Idempotency Key",
        "type": "string"
      }
    },
    "required": [
      "activity_id",
      "provider_ref",
      "external_tenant_id",
      "expected_selection_revision",
      "idempotency_key"
    ],
    "title": "WorkspaceSelectionRequest",
    "type": "object"
  },
  "WorkspaceRequestCreate": {
    "$defs": {
      "WorkspacePolicyChoices": {
        "additionalProperties": false,
        "properties": {
          "unit_codes": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Unit Codes",
            "type": "array"
          },
          "currencies": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Currencies",
            "type": "array"
          },
          "price_list_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Price List Ids",
            "type": "array"
          },
          "channels": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Channels",
            "type": "array"
          }
        },
        "title": "WorkspacePolicyChoices",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "activity_id": {
        "maxLength": 255,
        "minLength": 1,
        "title": "Activity Id",
        "type": "string"
      },
      "kind": {
        "enum": [
          "source_registration",
          "consumer_registration",
          "read_sharing",
          "native_origin"
        ],
        "title": "Kind",
        "type": "string"
      },
      "provider_ref": {
        "anyOf": [
          {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Provider Ref"
      },
      "source_installation_ref": {
        "anyOf": [
          {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Source Installation Ref"
      },
      "consumer_installation_ref": {
        "anyOf": [
          {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Consumer Installation Ref"
      },
      "native_product_ref": {
        "anyOf": [
          {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Native Product Ref"
      },
      "fields": {
        "items": {
          "enum": [
            "name",
            "description",
            "sku",
            "barcodes",
            "base_unit",
            "price",
            "media",
            "is_visible"
          ],
          "type": "string"
        },
        "maxItems": 8,
        "title": "Fields",
        "type": "array"
      },
      "people_refs": {
        "items": {
          "type": "string"
        },
        "maxItems": 100,
        "title": "People Refs",
        "type": "array"
      },
      "allowed_operations": {
        "items": {
          "enum": [
            "upsert",
            "hide",
            "unhide",
            "archive",
            "tombstone",
            "restore"
          ],
          "type": "string"
        },
        "maxItems": 6,
        "title": "Allowed Operations",
        "type": "array"
      },
      "expires_at": {
        "anyOf": [
          {
            "format": "date-time",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expires At"
      },
      "allow_restore": {
        "default": false,
        "title": "Allow Restore",
        "type": "boolean"
      },
      "policy_choices": {
        "$ref": "#/$defs/WorkspacePolicyChoices"
      },
      "idempotency_key": {
        "maxLength": 255,
        "minLength": 8,
        "title": "Idempotency Key",
        "type": "string"
      }
    },
    "required": [
      "activity_id",
      "kind",
      "idempotency_key"
    ],
    "title": "WorkspaceRequestCreate",
    "type": "object"
  },
