    "machine_status": "existing current platform service credential; exact own-platform namespace only"
  },
  "routes": {
    "register": {
      "method": "POST",
      "peer": "/v1/integration/workspace/namespaces",
      "portal_suffix": "workspace/namespaces",
      "status": 201,
      "request_model": "NamespaceRegistration",
      "response_model": "NamespaceResponse"
    },
    "lookup": {
      "method": "GET",
      "peer": "/v1/integration/workspace/namespaces/lookup",
      "portal_suffix": "workspace/namespaces/lookup",
      "query": [
        "idempotency_key"
      ],
      "response_model": "NamespaceResponse",
      "meaning": "read-only durable original registration receipt; 404 is unresolved, not proof no effect"
    },
    "revoke": {
      "method": "POST",
      "peer": "/v1/integration/workspace/namespaces/{namespace_id}/revoke",
      "portal_suffix": "workspace/namespaces/{namespace_id}/revoke",
      "request_model": "NamespaceRevocation",
      "response_model": "NamespaceResponse"
    },
    "current_native_status": {
      "method": "GET",
      "path": "/v1/integration/operational/namespaces/{namespace_id}",
      "response_model": "NamespaceResponse",
      "meaning": "current persisted namespace lifecycle and expiry; exact own platform; no browser actor claims"
    }
  },
  "prerequisites": [
    "real verified native account binding to the authenticated organization",
    "real named activity registered through normal owner flow",
    "prepare-provider authenticates current native discovery and enrolled public key; native accepts savana.collaboration.v1 independently of goods",
    "explicit current read.request plus read.approve scope actions; owner role alone grants neither",
    "current native ownership/delegation and signed active native subscription",
    "exact expected enrollment/namespace versions obtained from workspace metadata, never typed by owner",
    "explicit current capability/person/resource/field grants remain required for every business effect"
  ],
  "facts": {
    "genuine_installation": "same operational_installations and runtime_installation_bindings registry, exact account/activity; no goods BusinessEntity fabricated",
    "epoch": "persisted namespace lifecycle epoch, starts 1 only on actual new namespace commit; changes on explicit replacement/revocation",
    "product_ownership_epoch": "unchanged and separate; collaboration-only enrollment cannot publish products",
    "warehouse_epochs": "unchanged; every physical quantity leg requires actual inventory.physical warehouse authority",
    "new_business_grants": false,
    "new_product_credentials": false,
    "new_product_origin": false,
    "automatic_authority_transfer": false
